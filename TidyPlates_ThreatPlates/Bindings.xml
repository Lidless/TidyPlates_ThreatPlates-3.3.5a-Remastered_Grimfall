<Bindings>
	<Binding name="TPTP_ENEMY_NAMEPLATES" header="TPTP">
		TidyPlatesThreat:ToggleEnemyNameplates()
	</Binding>
	<Binding name="TPTP_FRIENDLY_PLAYERS">
		TidyPlatesThreat:ToggleFriendlyPlayers()
	</Binding>
	<Binding name="TPTP_FRIENDLY_NPCS">
		TidyPlatesThreat:ToggleFriendlyNPCs()
	</Binding>
	<Binding name="TPTP_ALL_NAMEPLATES">
		TidyPlatesThreat:ToggleAllNameplates()
	</Binding>
</Bindings>
